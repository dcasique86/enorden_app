# ============================================================
# EnOrden ERP — Variables de Entorno
# Copia este archivo como .env y completa los valores reales
# ============================================================

# --- Telegram Bot ---
# Token obtenido de @BotFather en Telegram (obligatorio para el bot)
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN_AQUI

# Tu ID numérico de usuario de Telegram (obligatorio para el bot)
# Puedes obtenerlo escribiendo a @userinfobot o @IDBot
TELEGRAM_ADMIN_ID=TU_TELEGRAM_ID_AQUI

# --- CORS ---
# Orígenes permitidos para CORS (separados por coma)
# Opcional — por defecto solo localhost:8000 y 127.0.0.1:8000
ENORDEN_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
